        public pnlprincipal()
        {
            InitializeComponent();
            this.StartPosition = FormStartPosition.CenterScreen;
            txtcodigo.KeyDown += Txtcodigo_KeyDown;
        }

        private void Txtcodigo_KeyDown(object? sender, KeyEventArgs e){
            if (e.KeyCode == Keys.Enter){
                int nro;
                if (int.TryParse(txtcodigo.Text, out int nro)) {
                    int.TryParse(txtcodigo.Text, out nro);
                    frmcargasaldo f = new frmcargasaldo(nro);
                    f.Show(this);
                    txtcodigo.Clear();
                    /*e.SuppressKeyPress = true; // Evita que se genere un sonido al presionar Enter*/
                } else { 
                    MessageBox.Show("Ingrese un código válido.", "Aviso", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    txtcodigo.Clear();
                    txtcodigo.Focus();
                }
            }
        }


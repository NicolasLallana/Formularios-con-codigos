using Microsoft.Data.SqlClient;
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Text;
using System.Windows.Forms;

namespace Validación_códigos
{
    public partial class frmcrearcliente : Form
    {
        private ConexionDB con;
        public frmcrearcliente()
        {
            con = new ConexionDB();
            InitializeComponent();
        }

        private void btnsalir_Click(object sender, EventArgs e)
        {
            this.Close();
        }

        private void frmasociartarjeta_Load(object sender, EventArgs e)
        {

        }

        private void btnconfirmar_Click(object sender, EventArgs e)
        {
            SqlConnection conexionsql = con.GetConnection();
            string query = "EXEC Crear_Cliente @Nro, @Nombre, @Fecha";
            SqlCommand cmd = new SqlCommand(query, conexionsql);
            cmd.Parameters.AddWithValue("@Nro", txtnro.Text);
            cmd.Parameters.AddWithValue("@Nombre", txtnombre.Text);
            cmd.Parameters.AddWithValue("@Fecha", txtfechanac.Value);
            cmd.ExecuteNonQuery();
        }
    }
}

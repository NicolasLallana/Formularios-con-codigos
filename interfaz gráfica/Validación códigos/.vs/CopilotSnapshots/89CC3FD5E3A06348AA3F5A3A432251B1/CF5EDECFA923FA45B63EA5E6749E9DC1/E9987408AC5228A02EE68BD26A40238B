using Microsoft.Data.SqlClient;
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Text;
using System.Windows.Forms;

namespace Validación_códigos
{
    public partial class frmcrearcliente : Form
    {
        private ConexionDB con;
        public frmcrearcliente()
        {
            con = new ConexionDB();
            InitializeComponent();
        }

        private void btnsalir_Click(object sender, EventArgs e)
        {
            this.Close();
        }

        private void frmasociartarjeta_Load(object sender, EventArgs e)
        {

        }

        private void btnconfirmar_Click(object sender, EventArgs e)
        {
            // Validar entradas básicas usando los nombres reales de los controles
            if (string.IsNullOrWhiteSpace(txttarjeta.Text) || string.IsNullOrWhiteSpace(txtnomnre.Text))
            {
                MessageBox.Show("Rellene los campos Nro. Tarjeta y Nombre.", "Aviso", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            // El procedimiento Crear_Cliente en la BD espera (@nom VARCHAR(20), @nac DATE)
            string query = "EXEC Crear_Cliente @nom, @nac";

            try
            {
                using (SqlConnection conexionsql = con.GetConnection())
                using (SqlCommand cmd = new SqlCommand(query, conexionsql))
                {
                    // Ajustar parámetros para coincidir con el procedure: @nom, @nac
                    cmd.Parameters.Add("@nom", System.Data.SqlDbType.VarChar, 20).Value = txtnomnre.Text.Trim();
                    // Parsear la fecha desde el TextBox txtfechanac
                    if (!DateTime.TryParse(txtfechanac.Text.Trim(), out DateTime fecha))
                    {
                        MessageBox.Show("Formato de fecha inválido. Use dd/mm/aaaa o formato local.", "Aviso", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        return;
                    }
                    cmd.Parameters.Add("@Fecha", System.Data.SqlDbType.Date).Value = fecha.Date;

                    conexionsql.Open();
                    cmd.ExecuteNonQuery();
                }

                MessageBox.Show("Cliente creado correctamente.", "Éxito", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error al crear cliente: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }
}
